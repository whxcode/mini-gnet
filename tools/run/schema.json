{
  "schema_version": 1,
  "name": "run_python",
  "description": "执行完整的临时 Python 源码。自动创建临时目录、写入 main.py、运行并清理；优先使用标准库。执行目录为临时目录，可通过绝对路径访问用户指定文件。临时目录不是安全沙箱，仅执行用户授权的操作。",
  "input_schema": {
    "type": "object",
    "properties": {
      "code": {"type": "string", "minLength": 1, "description": "完整 Python 源码，不含 Markdown 围栏；顶层不要多余缩进，使用 print 输出结果。"}
    },
    "required": ["code"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "stdout": {"type": "string"},
      "stderr": {"type": "string"},
      "exit_code": {"type": "integer"}
    },
    "required": ["stdout", "stderr", "exit_code"],
    "additionalProperties": false
  }
}
