{
  "schema_version": 1,
  "name": "city_weather",
  "description": "查询一个城市的当前天气，使用 Open-Meteo 公开接口，需要联网。city 可填城市中文名或英文名；返回首个匹配地点及地区、国家，请确认地点是否符合用户要求。",
  "input_schema": {
    "type": "object",
    "properties": {
      "city": {
        "type": "string",
        "minLength": 1,
        "description": "城市名称，例如成都或 Chengdu。找不到中文名时可以尝试英文名。"
      }
    },
    "required": ["city"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "city": {"type": "string"},
      "region": {"type": "string"},
      "country": {"type": "string"},
      "temperature": {"type": "string"},
      "humidity": {"type": "string"},
      "wind_speed": {"type": "string"},
      "condition": {"type": "string"},
      "observed_at": {"type": "string"},
      "timezone": {"type": "string"},
      "source": {"type": "string"}
    },
    "required": [
      "city", "region", "country", "temperature", "humidity",
      "wind_speed", "condition", "observed_at", "timezone", "source"
    ],
    "additionalProperties": false
  },
  "execution": {
    "command": "python3",
    "args": ["main.py"],
    "cwd": "."
  }
}
